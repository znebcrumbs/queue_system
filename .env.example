# ============================================
# DJANGO CORE SETTINGS
# ============================================
DEBUG=True
SECRET_KEY=your-very-secure-secret-key-minimum-50-chars-change-in-production!@#$%^&*()
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# DATABASE CONFIGURATION
# ============================================
USE_POSTGRES=False
# Set to True for production with PostgreSQL

# PostgreSQL Settings (required if USE_POSTGRES=True)
DB_NAME=queue_system
DB_USER=postgres
DB_PASSWORD=your-secure-db-password-here
DB_HOST=localhost
DB_PORT=5432

# ============================================
# SECURITY & KIOSK CONFIGURATION
# ============================================

# Production Security
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Kiosk API Authentication (CRITICAL - Set in production!)
KIOSK_API_KEY=your-secure-kiosk-api-key-change-in-production!!

# ============================================
# OPTIONAL: Email Configuration
# ============================================
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
