# ============================================
# DJANGO CORE SETTINGS
# ============================================
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-key-minimum-50-chars
ALLOWED_HOSTS=queue.example.com,www.queue.example.com
CSRF_TRUSTED_ORIGINS=https://queue.example.com,https://www.queue.example.com

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Required for production. SQLite is not approved for commercial production use.
USE_POSTGRES=True
DATABASE_URL=postgresql://queue_user:change-me@db:5432/queue_system?sslmode=require

# PostgreSQL Settings (only used if DATABASE_URL is not supplied)
DB_NAME=queue_system
DB_USER=queue_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=require

# ============================================
# SECURITY SETTINGS
# ============================================
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# ============================================
# KIOSK API AUTHENTICATION
# ============================================
KIOSK_API_KEY=replace-with-a-random-kiosk-api-key

# ============================================
# OPTIONAL: EMAIL CONFIGURATION
# ============================================
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
